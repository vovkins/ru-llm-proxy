# Minimal local quick-start configuration.
# Full grouped reference: docs/configuration.md

# === Default GLM Provider Pool ===
# Required Z.AI Coding Plan keys for the default glm-5.2/glm-5.1 model pool.
ZAI_API_KEY=***
ZAI_API_KEY_2=***

# === LiteLLM Admin And Secrets ===
# make setup replaces placeholder secrets and keeps real values intact.
LITELLM_MASTER_KEY=sk-replace-with-generated-key
LITELLM_SALT_KEY=replace-with-generated-salt
UI_USERNAME=admin
UI_PASSWORD=replace-with-generated-ui-password
DISABLE_ADMIN_UI=False

# === LiteLLM Persistence ===
POSTGRES_PASSWORD=***
LITELLM_DB_URL=postgresql://litellm:litellm@db:5432/litellm
