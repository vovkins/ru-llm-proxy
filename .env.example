# Минимальная конфигурация для локального быстрого запуска.
# Полный сгруппированный справочник: docs/configuration.md

# === Пул GLM-провайдера по умолчанию ===
# Обязательные ключи Z.AI Coding Plan для пула моделей glm-5.2/glm-5.1.
ZAI_API_KEY=***
ZAI_API_KEY_2=***

# === Административный доступ LiteLLM и секреты ===
# make setup заменяет плейсхолдеры секретов и не трогает уже заполненные значения.
LITELLM_MASTER_KEY=sk-replace-with-generated-key
LITELLM_SALT_KEY=replace-with-generated-salt
UI_USERNAME=admin
UI_PASSWORD=replace-with-generated-ui-password
DISABLE_ADMIN_UI=False

# === Постоянное состояние LiteLLM ===
POSTGRES_PASSWORD=***
LITELLM_DB_URL=postgresql://litellm:litellm@db:5432/litellm

# === Экспериментальный пул ChatGPT OAuth-подписок codex-lb ===
# Пароль отдельной базы генерирует make setup. Служебный ключ создаётся позднее
# в административном интерфейсе codex-lb и используется только LiteLLM.
CODEX_LB_POSTGRES_PASSWORD=***
CODEX_LB_API_KEY=***
