# Минимальная конфигурация для локального быстрого запуска.
# Полный сгруппированный справочник: docs/configuration.md

# === Пул GLM-провайдера по умолчанию ===
# Обязательные ключи Z.AI Coding Plan для пула моделей glm-5.2/glm-5.1.
ZAI_API_KEY=***
ZAI_API_KEY_2=***

# === Административный доступ LiteLLM и секреты ===
# make setup STACK=<состав> заменяет плейсхолдеры секретов выбранного состава
# и не трогает уже заполненные значения.
LITELLM_MASTER_KEY=sk-replace-with-generated-key
LITELLM_SALT_KEY=replace-with-generated-salt
UI_USERNAME=admin
UI_PASSWORD=replace-with-generated-ui-password
DISABLE_ADMIN_UI=False

# === Постоянное состояние LiteLLM ===
POSTGRES_PASSWORD=***
LITELLM_DB_URL=postgresql://litellm:litellm@db:5432/litellm

# === Пул ChatGPT OAuth-подписок codex-lb ===
# Пароль отдельной базы генерирует setup расширенного состава. После ручного
# создания администратора и импорта подписок setup выпускает служебный ключ
# через штатный API codex-lb и сохраняет его здесь только для LiteLLM.
CODEX_LB_POSTGRES_PASSWORD=***
CODEX_LB_API_KEY=***
# Штатные значения codex-lb. Для корпоративного прокси без WebSocket задайте
# соответственно false и http; подробности приведены в docs/air-gapped.md.
CODEX_LB_HTTP_RESPONSES_SESSION_BRIDGE_ENABLED=true
CODEX_LB_UPSTREAM_STREAM_TRANSPORT=auto

# === Изолированная среда: прокси и внутренние источники пакетов ===
# Пустые значения оставляют прямой сетевой доступ. Подробности: docs/air-gapped.md.
NGINX_HTTP_PORT=80
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,redis,presidio-analyzer,litellm,nginx,codex-lb,codex-lb-db
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_PROXY=
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
NER_MODEL_PROXY=
# NER-модель Analyzer: bert (по умолчанию) или tiny2. Для tiny2 перед сборкой
# положите файлы модели в presidio/model-artifacts/tiny2/ (см. README там).
NER_MODEL_PROFILE=bert
# Optional external Triton backend; docker-compose.triton.yml selects it explicitly.
PRESIDIO_ANALYZER_NER_BACKEND=transformers
PRESIDIO_ANALYZER_TRITON_URL=http://ner-triton:8000
PRESIDIO_ANALYZER_TRITON_MODEL_NAME=tiny2
PRESIDIO_ANALYZER_TRITON_MODEL_VERSION=1
PRESIDIO_ANALYZER_TRITON_TIMEOUT_SECONDS=60
TRITON_MODEL_INSTANCES=1
# Пустые значения оставляют настройки профиля.
PRESIDIO_ANALYZER_NER_O_LOGIT_BIAS=
PRESIDIO_ANALYZER_NER_SPAN_POSTPROCESSING=
