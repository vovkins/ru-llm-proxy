# LiteLLM: экземпляры и ограничения каждого контейнера.
LITELLM_REPLICAS=2
LITELLM_CPUS=2.0
LITELLM_MEMORY=4g

# Измеренный CPU-профиль A для 32 vCPU / 64 GB, с переподпиской.
# Лимиты не резервируют ресурсы; см. docs/research/production-acceptance.md.
ANALYZER_REPLICAS=24
ANALYZER_CPUS=1.0
ANALYZER_MEMORY=2g

# По два исполнения модели в каждом Triton; ёмкость 400 человек не подтверждена.
TRITON_REPLICAS=12
TRITON_CPUS=2.0
TRITON_MEMORY=4g
TRITON_MODEL_INSTANCES=2

# Общий Nginx и хранилища базового состава.
NGINX_CPUS=1.0
NGINX_MEMORY=256m
REDIS_CPUS=1.0
REDIS_MEMORY=16g
DB_CPUS=2.0
DB_MEMORY=4g

# Дополнительные компоненты состава с codex-lb.
CODEX_LB_CPUS=2.0
CODEX_LB_MEMORY=4g
CODEX_LB_DB_CPUS=1.0
CODEX_LB_DB_MEMORY=2g
