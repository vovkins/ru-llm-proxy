# LiteLLM: экземпляры и ограничения каждого контейнера.
LITELLM_REPLICAS=2
LITELLM_CPUS=2.0
LITELLM_MEMORY=4g

# Analyzer: один процесс и один активный анализ на контейнер.
ANALYZER_REPLICAS=4
ANALYZER_CPUS=4.0
ANALYZER_MEMORY=8g

# Общий Nginx и хранилища базового состава.
NGINX_CPUS=1.0
NGINX_MEMORY=256m
REDIS_CPUS=1.0
REDIS_MEMORY=2g
DB_CPUS=2.0
DB_MEMORY=4g

# Дополнительные компоненты состава с codex-lb.
CODEX_LB_CPUS=2.0
CODEX_LB_MEMORY=4g
CODEX_LB_DB_CPUS=1.0
CODEX_LB_DB_MEMORY=2g
