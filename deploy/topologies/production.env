# LiteLLM: экземпляры и ограничения каждого контейнера.
LITELLM_REPLICAS=2
LITELLM_CPUS=2.0
LITELLM_MEMORY=4g

# Analyzer: один процесс, два активных анализа и очередь 32 на контейнер.
ANALYZER_REPLICAS=4
ANALYZER_CPUS=2.0
ANALYZER_MEMORY=4g

# CPU-профиль по локальным измерениям Э10; ёмкость на 400 человек не подтверждена.
TRITON_REPLICAS=2
TRITON_CPUS=2.0
TRITON_MEMORY=2g
TRITON_MODEL_INSTANCES=2

# Общий Nginx и хранилища базового состава.
NGINX_CPUS=1.0
NGINX_MEMORY=256m
REDIS_CPUS=1.0
REDIS_MEMORY=16g
DB_CPUS=2.0
DB_MEMORY=4g

# Дополнительные компоненты состава с codex-lb.
CODEX_LB_CPUS=2.0
CODEX_LB_MEMORY=4g
CODEX_LB_DB_CPUS=1.0
CODEX_LB_DB_MEMORY=2g
