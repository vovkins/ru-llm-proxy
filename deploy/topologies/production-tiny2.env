# Tiny2 (ANALYZER_PROFILE=tiny2) поверх production.env: пул NER в пределах 8 CPU.
# Исходная оценка по одной реплике на 4 CPU (Analyzer около 1 CPU, Triton около 2,3 CPU
# при 30 одновременных историях 10k); требует замера на целевом сервере.

# Analyzer: два процесса по четыре анализа в каждом контейнере.
ANALYZER_REPLICAS=2
ANALYZER_CPUS=1.5
ANALYZER_MEMORY=4g

# Общий Triton для всех Analyzer.
TRITON_CPUS=5.0
TRITON_MEMORY=6g
TRITON_MODEL_INSTANCES=5
