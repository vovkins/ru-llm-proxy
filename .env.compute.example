# Только локальные вычисления; ключи, пароли БД и подписки сюда не копируют.
# Количества и ресурсы: production.env / TOPOLOGY_ENV, без нового подбора.
# NODE_ROLE и NODE_CONFIG задаются контекстом команды, не сохраняются здесь.

# Необязательные параметры корпоративной сборки.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,nginx,presidio-analyzer,ner-triton
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_PROXY=
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
NER_MODEL_PROXY=

# Те же правила анализа, что у основного узла; явные переопределения согласуют.
PRESIDIO_ANALYZER_BASE64_POLICY=content
