log_format node_attempts escape=json
    '{"request_id":"$http_x_ru_llm_request_id","field":"$http_x_ru_llm_text_field_index",'
    '"connection":"$connection","connection_requests":$connection_requests,'
    '"method":"$request_method","status":$status,"upstream":"$upstream_addr",'
    '"upstream_status":"$upstream_status","time":"$upstream_response_time"}';

upstream analyzer_instances {
    zone analyzer_instances 64k;
    least_conn;
    server presidio-analyzer:5001 resolve;
    keepalive 64;
    keepalive_timeout 4s;
}

server {
    listen 80;
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }
    location / { return 404; }
}

server {
    listen 5001;
    client_max_body_size 25m;
    access_log /dev/stdout node_attempts;
    allow 127.0.0.1;
    ${SOURCE_RULES}
    deny all;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_next_upstream off;
    proxy_intercept_errors off;
    location = /api/v1/health {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_pass http://analyzer_instances;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
    }
    location = /api/v1/analyze {
        if ($request_method != POST) { return 405; }
        proxy_pass http://analyzer_instances;
        proxy_read_timeout 1500s;
        proxy_send_timeout 1500s;
    }
    location / { return 404; }
}
