map $http_upgrade $connection_upgrade {
    default upgrade;
    '' '';
}

log_format node_attempts escape=json
    '{"request_id":"$http_x_ru_llm_request_id","field":"$http_x_ru_llm_text_field_index",'
    '"connection":"$connection","connection_requests":$connection_requests,'
    '"method":"$request_method","status":$status,"upstream":"$upstream_addr",'
    '"upstream_status":"$upstream_status","time":"$upstream_response_time"}';

upstream litellm_instances {
    zone litellm_instances 64k;
    least_conn;
    server litellm:4000 resolve;
    keepalive 64;
    keepalive_timeout 4s;
}

upstream analyzer_instances {
    zone analyzer_instances 64k;
    least_conn;
    server presidio-analyzer:5001 resolve;
    keepalive 64;
    keepalive_timeout 4s;
}

upstream node_analyzers {
    zone node_analyzers 64k;
    least_conn;
    server 127.0.0.1:5002 max_fails=1 fail_timeout=5s;
    server ${COMPUTE_ENDPOINT} max_fails=1 fail_timeout=5s;
    # No idle connection cache here. Local model/Analyzer pools retain theirs.
}

server {
    listen 80;
    listen 4000;
    server_name _;
    client_max_body_size 25m;
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }
    location / {
        proxy_pass http://litellm_instances;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1500s;
        proxy_send_timeout 1500s;
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
    }
}

server {
    listen 5001;
    client_max_body_size 25m;
    access_log /dev/stdout node_attempts;
    proxy_http_version 1.1;
    proxy_set_header Connection close;
    proxy_socket_keepalive on;
    proxy_intercept_errors off;
    proxy_connect_timeout 5s;
    proxy_request_buffering on;
    location = /api/v1/health {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_method GET;
        proxy_pass http://node_analyzers;
        proxy_buffering off;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
        proxy_next_upstream error timeout http_502;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 10s;
    }
    location = /api/v1/analyze {
        if ($request_method != POST) { return 405; }
        proxy_pass http://node_analyzers;
        proxy_read_timeout 1500s;
        proxy_send_timeout 1500s;
        proxy_next_upstream error timeout http_502 non_idempotent;
        proxy_next_upstream_tries 2;
    }
    location / { return 404; }
}

server {
    listen 127.0.0.1:5002;
    client_max_body_size 25m;
    access_log /dev/stdout node_attempts;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_next_upstream off;
    proxy_intercept_errors off;
    location = /api/v1/health {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_method GET;
        proxy_pass http://analyzer_instances;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
    }
    location = /api/v1/analyze {
        if ($request_method != POST) { return 405; }
        proxy_pass http://analyzer_instances;
        proxy_read_timeout 1500s;
        proxy_send_timeout 1500s;
    }
    location / { return 404; }
}

server {
    listen 2455;
    client_max_body_size 25m;
    location / {
        set $upstream http://codex-lb:2455;
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
